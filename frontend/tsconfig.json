{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "types": ["node", "react"]
  },
  "include": [
    "app/**/*.tsx",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "services/**/*.ts",
    "services/**/*.tsx",
    "types/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "demo-server"]
}
